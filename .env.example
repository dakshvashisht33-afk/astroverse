# Use a strong random secret outside local development.
SECRET_KEY=replace-with-a-long-random-secret
# Optional PostgreSQL example:
# DATABASE_URL=postgresql://user:password@localhost:5432/astroverse
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001
# Optional Astro AI provider configuration. Keep API keys on the backend only.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash-lite
# To use OpenAI instead, set AI_PROVIDER=openai and configure OPENAI_API_KEY/OPENAI_MODEL.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
